{
  "name": "pixiv-token-getter",
  "version": "2.0.0",
  "description": "A Node.js library and CLI tool to get Pixiv login tokens using Puppeteer. Easy to integrate into your projects.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./lib": {
      "require": "./lib/index.js",
      "types": "./index.d.ts"
    },
    "./cli": "./cli.js"
  },
  "bin": {
    "pixiv-token-getter": "./cli.js",
    "ptg": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "interactive": "node cli.js --interactive",
    "headless": "node cli.js --headless",
    "example": "node examples/basic-usage.js"
  },
  "keywords": [
    "pixiv",
    "token",
    "puppeteer",
    "login",
    "oauth",
    "cli",
    "authentication",
    "api",
    "sdk",
    "pixiv-api"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/pixiv-token-getter.git"
  },
  "dependencies": {
    "puppeteer": "^21.5.0",
    "axios": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "lib/",
    "cli.js",
    "index.js",
    "index.d.ts",
    "README.md",
    "examples/"
  ]
}

