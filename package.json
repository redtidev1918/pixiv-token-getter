{
  "name": "pixiv-token-getter",
  "version": "2.5.0",
  "description": "Node.js Pixiv credential manager and authentication facade - token cache, refresh-token lifecycle, profiles, PKCE OAuth + Puppeteer login, optional gppt interoperability. Library and CLI (ptg). TypeScript types included.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./lib": {
      "require": "./lib/index.js",
      "types": "./index.d.ts"
    },
    "./cli": "./cli.js"
  },
  "bin": {
    "pixiv-token-getter": "cli.js",
    "ptg": "cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "test": "node --test",
    "interactive": "node cli.js --interactive",
    "headless": "node cli.js --headless",
    "example": "node examples/basic-usage.js",
    "example:lifecycle": "node examples/credential-lifecycle.js"
  },
  "keywords": [
    "pixiv",
    "token",
    "credential-manager",
    "refresh-token",
    "puppeteer",
    "login",
    "oauth",
    "pkce",
    "cli",
    "authentication",
    "api",
    "sdk",
    "pixiv-api",
    "gppt"
  ],
  "author": "redtidev1918",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redtidev1918/pixiv-token-getter.git"
  },
  "bugs": {
    "url": "https://github.com/redtidev1918/pixiv-token-getter/issues"
  },
  "homepage": "https://redtidev1918.github.io/pixiv-token-getter/",
  "sideEffects": false,
  "dependencies": {
    "axios": "^1.6.0",
    "puppeteer-core": "^25.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib/",
    "cli.js",
    "index.js",
    "index.d.ts",
    "README.md",
    "README.en.md",
    "MIGRATION.md",
    "MIGRATION.en.md",
    "ACKNOWLEDGMENTS.md",
    "ACKNOWLEDGMENTS.en.md",
    "LICENSE",
    "examples/"
  ]
}
